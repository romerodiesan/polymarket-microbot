# Either the YES/NO token IDs of one binary market...
PM_YES_TOKEN_ID=
PM_NO_TOKEN_ID=
# ...or a rolling series (e.g. btc-up-or-down-15m), followed market by market. Takes precedence.
PM_SERIES_SLUG=
# Seconds before each market closes to sell open positions and move to the next one.
PM_ROLLOVER_SECONDS=30

# paper is the safe default. live requires PM_ENABLE_LIVE_TRADING=I_UNDERSTAND_THE_RISK.
PM_MODE=paper
PM_DB_PATH=data/microbot.duckdb
PM_PARQUET_DIR=data/parquet
PM_FEATURE_INTERVAL_MS=500
PM_SIGNAL_THRESHOLD=0.22
PM_EXIT_THRESHOLD=0.04
PM_MAX_POSITION_SHARES=25
PM_ORDER_SIZE_SHARES=2
PM_MAX_SPREAD=0.08
PM_MIN_TOP_DEPTH=5
PM_COOLDOWN_SECONDS=3
PM_STALE_BOOK_SECONDS=5
PM_MODEL_PATH=

# Research entry pauses (0 disables a limit). These are conservative controls, not fitted alpha.
# Daily realized net P&L and the losing-exit streak persist across run IDs until midnight UTC.
PM_MAX_DAILY_LOSS=10
PM_MAX_CONSECUTIVE_LOSSES=5
PM_MAX_ENTRIES_PER_MARKET=3
PM_LOSS_COOLDOWN_SECONDS=30
# Profit target: net USDC/share at the sell limit, after both entry and exit fees.
PM_TAKE_PROFIT=0.03
# Stop: midpoint movement from the average entry execution price, before entry fees.
PM_STOP_LOSS=0.02
# A live execution error writes this marker and blocks automatic live restarts.
PM_EXECUTION_HALT_PATH=data/bot/execution_halt.json

# Needed only for live mode. Never commit the populated .env file.
PM_PRIVATE_KEY=
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=
PM_FUNDER=
PM_SIGNATURE_TYPE=0
PM_ENABLE_LIVE_TRADING=

