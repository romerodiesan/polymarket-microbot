# Secrets: only the template is versioned.
.env
.env.*
!.env.example

# Python virtualenvs
.bot/
.venv/
venv/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

